{
  "name": "openstrm",
  "private": true,
  "version": "2.15.0",
  "description": "OpenStrm - Strm Management Platform",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -n backend,proxy,frontend -c blue,magenta,green \"pnpm --filter @openstrm/backend dev\" \"pnpm --filter @openstrm/backend dev:proxy\" \"pnpm --filter @openstrm/frontend dev\"",
    "build": "pnpm --filter @openstrm/backend build && pnpm --filter @openstrm/frontend build",
    "build:backend": "pnpm --filter @openstrm/backend build",
    "build:frontend": "pnpm --filter @openstrm/frontend build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "CONFIG_DIR=/tmp/openstrm-test/config DATA_DIR=/tmp/openstrm-test/data pnpm --filter @openstrm/backend test"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.3"
}
